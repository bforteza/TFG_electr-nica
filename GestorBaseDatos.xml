<?xml version="1.0"?>
<!DOCTYPE database SYSTEM "lite sql.dtd"> 


<database name="DbManager" namespace="kdb">
    <object name="Person">
        <field name="name" type="string"/>
        <field name="password" type="string"/>
        <field name="uid" type="string"/>
        <field name="level" type="integer" default="0"/>
    </object>
    <object name="Key">
        <field name="name" type="string"/>
        <field name="ubi" type="string"/>
        <field name="commentary" type="string"/>
        <field name="pos" type="integer" default="0"/>
        <field name="active" type="boolean"/>
        <field name="uid" type="string"/>
        <field name="pub" type="boolean" default="false"/>
    </object>
    <relation id="Acces">
        <relate object="Person" handle="keys" limit="many"/>
        <relate object="Key" handle="owners" limit="many"/>
    </relation>
    <relation id="Keep">
        <relate object="Person" handle="keepkeys" limit="one"/>
        <relate object="Key"    handle="keeper" limit="many"/>
    </relation>
    <object name="HistoryEvent">
        <field name="etype"      type="integer" default="0"/>
        <field name="timestamp"  type="string"  default=""/>
        <field name="keyid"      type="integer" default="0"/>
        <field name="keyname"    type="string"  default=""/>
        <field name="personid"   type="integer" default="0"/>
        <field name="personname" type="string"  default=""/>
        <field name="pos"        type="integer" default="0"/>
    </object>
</database>    

