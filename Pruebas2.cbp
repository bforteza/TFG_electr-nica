	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Pruebas2" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Pruebas2" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="`pkg-config gtkmm-3.0 libcanberra-gtk3 --cflags`" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="`pkg-config gtkmm-3.0 libcanberra-gtk3 --libs`" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Pruebas2" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="`pkg-config gtkmm-3.0 libcanberra-gtk3 --cflags`" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="`pkg-config gtkmm-3.0 libcanberra-gtk3 --libs`" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add option="-std=c++17" />
			<Add directory="/usr/include/mariadb" />
		</Compiler>
		<Linker>
			<Add library="/usr/local/lib/static/liblitesql-util.a" />
			<Add library="/usr/local/lib/static/liblitesql.a" />
